NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/candletsales?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Tài khoản Admin mặc định (dùng cho script seedAdmin.js)
DEFAULT_ADMIN_EMAIL=admin@candletsales.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_NAME=Admin

# CORS - URL frontend
CLIENT_URL=http://localhost:3000
