NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/candletsales?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Tài khoản Admin mặc định (dùng cho script seedAdmin.js)
DEFAULT_ADMIN_EMAIL=admin@candletsales.com
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_unique_password
DEFAULT_ADMIN_NAME=Admin

# CORS - URL frontend
# Có thể khai báo nhiều origin, ngăn cách bằng dấu phẩy.
CLIENT_URL=http://localhost:5173

# SePay QR payments (QR validity: 5-60 minutes, default 15)
SEPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret
SEPAY_ACCOUNT_NUMBER=your_receiving_account_number
SEPAY_QR_EXPIRES_MINUTES=15

# Email thông báo đơn Website (Gmail SMTP miễn phí)
# Bật xác minh 2 bước cho Gmail, rồi tạo App Password 16 ký tự.
MAIL_SMTP_USER=your-shop@gmail.com
MAIL_SMTP_APP_PASSWORD=your_16_character_gmail_app_password
# Có thể để trống để gửi về chính MAIL_SMTP_USER; nhiều email ngăn cách bằng dấu phẩy.
MAIL_NOTIFICATION_TO=your-shop@gmail.com
MAIL_FROM_NAME=CandletShop

# Facebook Login (chỉ dành cho tài khoản khách hàng)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback

# Google Login (chỉ dành cho tài khoản khách hàng)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pancake webhook
PANCAKE_WEBHOOK_SECRET=

# Gemini
GEMINI_API_KEY=
